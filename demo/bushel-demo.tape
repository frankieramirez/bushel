Output demo/bushel-demo.gif
Output demo/bushel-demo.mp4
Output demo/bushel-demo.webm

Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 760
Set Padding 16
Set TypingSpeed 60ms

Type "bushel"
Sleep 500ms
Enter
Sleep 3.5s

Type "j"
Sleep 600ms
Type "j"
Sleep 600ms
Type "j"
Sleep 600ms
Type "j"
Sleep 900ms

Enter
Sleep 1s
Type "l"
Sleep 1s
Type "F"
Sleep 4.5s

Escape
Sleep 800ms
Type "k"
Sleep 800ms

Space
Sleep 1.8s
Type "s"
Sleep 2.2s
Type "y"
Sleep 3s
Type "s"
Sleep 1.5s
Type "y"
Sleep 3.5s

Type "2"
Sleep 1.8s
Type "1"
Sleep 1.5s
Type "q"
Sleep 800ms
